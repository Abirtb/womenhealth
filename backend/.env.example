# Copy to backend/.env and fill in (never commit .env)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY
# Must be the CONTRACT address from Remix (Contract Creation tx), NOT your MetaMask account address
PROVENANCE_CONTRACT=0xYOUR_DEPLOYED_CONTRACT

# Optional: RAG diet recipes (Ollama + FAISS under backend/rag/)
# NURTURA_USE_RAG=false
# OLLAMA_API_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=deepseek-r1:7b
